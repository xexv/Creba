{
  "name": "Creba Network Filter",
  "version": "1.1",
  "homepage_url": "https://github.com/xexv/Creba",
  "description": "Remove CSP headers, configure WebRTC IP handling, and block telemetry/bloat requests",
  "manifest_version": 3,
  "permissions": [
    "declarativeNetRequest",
    "privacy"
  ],
  "host_permissions": [
    "*://*.discord.com/*",
    "*://discord.com/*",
    "*://*.discordapp.com/*",
    "*://*.sentry.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "csp_disabler",
        "path": "dnr-rules.json",
        "enabled": true
      }
    ]
  }
}
