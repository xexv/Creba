[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [{
        "header": "content-security-policy",
        "operation": "remove"
      }]
    },
    "condition": {
      "resourceTypes": [
        "main_frame",
        "sub_frame"
      ]
    }
  },
  {
    "id": 2,
    "priority": 2,
    "action": { "type": "block" },
    "condition": {
      "regexFilter": "/api/v\\d+/(science|track|metrics|premium-marketing)",
      "resourceTypes": ["xmlhttprequest", "ping", "other"]
    }
  },
  {
    "id": 3,
    "priority": 2,
    "action": { "type": "block" },
    "condition": {
      "regexFilter": "sentry\\.io|/error-reporting|crash[-_]report",
      "resourceTypes": ["xmlhttprequest", "ping", "other", "script"]
    }
  },
  {
    "id": 4,
    "priority": 2,
    "action": { "type": "block" },
    "condition": {
      "regexFilter": "avatar-decoration-presets|/profile_effects/|/clan-badges/|/collectibles/",
      "resourceTypes": ["image", "media", "xmlhttprequest"]
    }
  },
  {
    "id": 5,
    "priority": 2,
    "action": { "type": "block" },
    "condition": {
      "regexFilter": "/api/v\\d+/quests|/quests-embed|/assets/quests",
      "resourceTypes": ["xmlhttprequest", "image", "media", "other"]
    }
  }
